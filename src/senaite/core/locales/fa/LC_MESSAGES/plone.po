msgstr "فعال‌کردن جست‌وجوی زنده"

#. TPPC settings interface translation
msgid "Enable RSS link document action on the syndication content item."
msgstr "فعال‌کردن پیوند RSS در عملیات سند برای محتوای دارای خوراک."

#. TPPC settings interface translation
msgid "Enable User Folders"
msgstr "فعال‌کردن پوشهٔ شخصی کاربران"

#. TPPC settings interface translation
msgid "Enable anonymous comments"
msgstr "فعال‌کردن نظر ناشناس"

#. TPPC settings interface translation
msgid "Enable anonymous email field"
msgstr "فعال‌کردن فیلد ایمیل برای نظر ناشناس"

#. TPPC settings interface translation
msgid "Enable auto resizing of the editor window."
msgstr "تغییر خودکار اندازهٔ پنجرهٔ ویرایشگر."

#. TPPC settings interface translation
msgid ""
"Enable automatic image captioning for images set in the richtext editor "
