msgstr "ارتفاع ویرایشگر"

#. TPPC settings interface translation
msgid "Editor plugins"
msgstr "افزونه‌های ویرایشگر"

#. TPPC settings interface translation
msgid "Editor width"
msgstr "عرض ویرایشگر"

