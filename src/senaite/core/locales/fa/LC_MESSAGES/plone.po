#. TPPC settings interface translation
msgid ""
"Use automatically generated UUIDs as user id for new users. When not turned "
"on, the default is to use the same as the login name, or when using the "
"email address as login name we generate a user id based on the fullname."
msgstr ""
"برای کاربران جدید UUID تولید می‌شود. در غیر این صورت شناسه معمولاً همان نام "
"ورود است؛ هنگام ورود با ایمیل، شناسه از نام کامل تولید می‌شود."

#. TPPC settings interface translation
msgid "Use browser language request negotiation"
msgstr "انتخاب زبان بر اساس درخواست مرورگر"

#. TPPC settings interface translation
msgid "Use browser language request negotiation."
msgstr "انتخاب زبان بر اساس زبان‌های درخواستی مرورگر."

#. TPPC settings interface translation
msgid "Use email address as login name"
msgstr "استفاده از ایمیل به‌عنوان نام ورود"

#. TPPC settings interface translation
