<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="senaite.core">

  <!-- Assign a customer access token on creation of customer-care records -->
  <subscriber
      for="senaite.core.interfaces.IComplaint
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".customercare_events.assign_access_token" />
  <subscriber
      for="senaite.core.interfaces.ISupportRequest
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".customercare_events.assign_access_token" />
  <subscriber
      for="senaite.core.interfaces.ISurvey
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".customercare_events.assign_access_token" />
  <subscriber
      for="senaite.core.interfaces.ISampleRequest
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".customercare_events.assign_access_token" />

  <!-- Alert the lab (by email) when a new online request is submitted, so
       staff know even when nobody is logged in. Fire on the api.create
       "after created" event (NOT IObjectAddedEvent): for Dexterity content
       api.create fires ObjectAddedEvent *before* the schema fields (contact
       name/email/phone) are set, so the alert would otherwise see them empty.
       IAfterAPICreatedObjectEvent fires once every field is in place. -->
  <subscriber
      for="senaite.core.interfaces.IComplaint
           senaite.core.events.lifecycle.IAfterAPICreatedObjectEvent"
      handler=".customercare_events.notify_lab_on_new" />
  <subscriber
      for="senaite.core.interfaces.ISupportRequest
           senaite.core.events.lifecycle.IAfterAPICreatedObjectEvent"
      handler=".customercare_events.notify_lab_on_new" />
  <subscriber
      for="senaite.core.interfaces.ISurvey
           senaite.core.events.lifecycle.IAfterAPICreatedObjectEvent"
      handler=".customercare_events.notify_lab_on_new" />
  <subscriber
      for="senaite.core.interfaces.ISampleRequest
           senaite.core.events.lifecycle.IAfterAPICreatedObjectEvent"
      handler=".customercare_events.notify_lab_on_new" />

  <!-- Email the customer their answer + tracking link when a request is
       closed (complaints and support requests use the customerrequest
       workflow, which has a 'close' transition). -->
  <subscriber
      for="senaite.core.interfaces.IComplaint
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".customercare_events.notify_customer_on_close" />
  <subscriber
      for="senaite.core.interfaces.ISupportRequest
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".customercare_events.notify_customer_on_close" />
  <subscriber
      for="senaite.core.interfaces.ISampleRequest
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".customercare_events.notify_customer_on_close" />

</configure>
