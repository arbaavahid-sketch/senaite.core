<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      metal:use-macro="here/main_template/macros/master">
<body>

  <metal:override fill-slot="top_slot"
      tal:define="dc1 python:request.set('disable_plone.leftcolumn', 1);
                  dc2 python:request.set('disable_plone.rightcolumn', 1);" />

  <div metal:fill-slot="content"
       tal:define="L view/labels; rtl view/is_rtl;
                   align python:'right' if rtl else 'left'"
       tal:attributes="dir python:'rtl' if rtl else 'ltr'"
       style="max-width:640px">

    <!-- Public customer page: hide the whole staff toolbar (login, search
         spotlight, menu) so customers get a clean form-only page. -->
    <style type="text/css">#senaite-toolbar{display:none !important;}</style>

    <div tal:attributes="style string:border-bottom:2px solid #0d6efd;; margin-bottom:1.5rem;; padding-bottom:.5rem;; text-align:${align}">
      <strong style="font-size:1.1rem"
              tal:content="context/@@plone_portal_state/navigation_root_title">Laboratory</strong>
    </div>

    <h1 tal:attributes="style string:text-align:${align}" tal:content="L/title">Track</h1>
    <p class="text-muted" tal:attributes="style string:text-align:${align}"
       tal:content="L/intro">intro</p>

    <form method="get" tal:attributes="style string:text-align:${align}">
      <div class="form-group">
        <label tal:content="L/tracking">Tracking</label>
        <input type="text" class="form-control" name="tracking"
               tal:attributes="value view/tracking_id"/>
      </div>
      <div class="form-group">
        <label tal:content="L/client">Client</label>
        <input type="text" class="form-control" name="client_name"
               tal:attributes="value view/client_name"/>
      </div>
      <button type="submit" name="track" value="1"
              class="btn btn-primary" tal:content="L/track">Track</button>
      <a href="customer-feedback" class="btn btn-link"
         tal:content="L/submit_link">Submit new</a>
    </form>

    <div tal:condition="view/not_found" class="alert alert-warning mt-3"
         tal:attributes="style string:text-align:${align}"
         tal:content="L/not_found">Not found</div>

    <table tal:condition="view/result"
           class="table mt-3" tal:attributes="style string:text-align:${align}"
           tal:define="r view/result">
      <tr>
        <th tal:content="L/type">Type</th>
        <td tal:content="r/type">type</td>
      </tr>
      <tr>
        <th tal:content="L/subject">Subject</th>
        <td tal:content="r/subject">subject</td>
      </tr>
      <tr>
        <th tal:content="L/status">Status</th>
        <td><span class="badge badge-info" tal:content="r/status">status</span></td>
      </tr>
      <tr tal:condition="r/sample_id">
        <th tal:content="L/sample">Sample</th>
        <td><code tal:content="r/sample_id">sample</code></td>
      </tr>
      <tr>
        <th tal:content="L/response">Response</th>
        <td style="white-space:pre-line">
          <span tal:condition="r/response" tal:content="r/response">response</span>
          <span tal:condition="python:not r['response'] and r['sample_id']"
                class="text-muted" tal:content="L/results_ready">ready</span>
          <span tal:condition="python:not r['response'] and not r['sample_id']"
                class="text-muted" tal:content="L/no_response">none</span>
        </td>
      </tr>
    </table>

  </div>
</body>
</html>
