<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="senaite.core">

  <!-- Staff: set the amount to charge for a request -->
  <browser:page
      for="senaite.core.interfaces.ISampleRequest"
      name="set-payment"
      class=".views.SetPaymentView"
      permission="senaite.core.permissions.ManageBika"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Public: start a Zarinpal payment (?token=...) -->
  <browser:page
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      name="pay"
      class=".views.PayView"
      permission="zope2.View"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Public: Zarinpal payment callback -->
  <browser:page
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      name="pay-callback"
      class=".views.PayCallbackView"
      permission="zope2.View"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Staff: payments dashboard -->
  <browser:page
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      name="payments"
      class=".views.PaymentsListView"
      permission="senaite.core.permissions.ManageBika"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

</configure>
