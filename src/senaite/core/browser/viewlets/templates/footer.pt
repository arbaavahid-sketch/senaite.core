<footer i18n:domain="senaite.core"
        id="senaite-footer">

  <div class="row">
    <div class="col-md-12">
      <hr/>
      <!-- footer portlets -->
      <div tal:on-error="nothing" tal:replace="structure view/render_footer_portlets" />
      <div class="float-left">
        <span tal:omit-tag="">
          <abbr title="Copyright">&copy;</abbr>
          <tal:year tal:content="view/year" />
          <a href="https://tppc.ir"
              target="_blank">آزمایشگاه پتروشیمی تندیس پارس (TPPC)</a>
        </span>
      </div>
      <div class="float-right"
           tal:define="portal_url context/@@plone_portal_state/portal_url">
        <ul class="nav nav-pills">
          <li><a class="nav-link"
                 tal:attributes="href string:${portal_url}/@@customer-feedback">
              <i class="fas fa-comment-dots"></i>
              <span i18n:translate="footer_submit_request">Submit a request</span></a></li>
          <li><a class="nav-link"
                 tal:attributes="href string:${portal_url}/@@track-request">
              <i class="fas fa-search"></i>
              <span i18n:translate="footer_track_request">Track a request</span></a></li>
          <li><a class="nav-link" href="https://tppc.ir" title="tppc.ir" target="_blank"><i class="fas fa-globe"></i></a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
