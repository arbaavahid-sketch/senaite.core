<footer i18n:domain="senaite.core"
        id="senaite-footer">

  <div class="row">
    <div class="col-md-12">
      <hr/>
      <!-- footer portlets -->
      <div tal:on-error="nothing" tal:replace="structure view/render_footer_portlets" />
      <div class="float-left">
        <span tal:omit-tag="">
          <abbr title="Copyright">&copy;</abbr>
          <tal:year tal:content="view/year" />
          <a href="https://tppc.ir"
              target="_blank">آزمایشگاه پتروشیمی تندیس پارس (TPPC)</a>
        </span>
      </div>
      <div class="float-right">
        <ul class="nav nav-pills">
          <li><a class="nav-link" href="https://tppc.ir" title="tppc.ir" target="_blank"><i class="fas fa-globe"></i></a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
