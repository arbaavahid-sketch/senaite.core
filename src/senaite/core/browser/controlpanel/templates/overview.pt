<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      metal:use-macro="here/prefs_main_template/macros/master"
      i18n:domain="plone">

  <body>
    <metal:override fill-slot="top_slot"
                    tal:define="disable_column_one python:request.set('disable_plone.leftcolumn',1);
                                disable_column_two python:request.set('disable_plone.rightcolumn',1);"/>

    <div metal:fill-slot="prefs_configlet_main" class="cp-page" tal:define="rtl view/is_rtl" tal:attributes="dir python:'rtl' if rtl else 'ltr'">
      <style tal:content="structure view/settings_styles"></style>

      <header class="cp-header">
        <div class="cp-heading"><span class="cp-header-icon" aria-hidden="true"><i class="fas fa-sliders"></i></span><div>
          <h1 class="documentFirstHeading" tal:content="python:view.page_text('title')">Site settings</h1>
          <p class="documentDescription" tal:content="python:view.page_text('intro')">Site administration</p>
        </div></div>
        <div class="cp-search"><label for="cp-search" tal:content="python:view.page_text('search')">Search settings</label>
          <div><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input id="cp-search" type="search" autocomplete="off" tal:attributes="placeholder python:view.page_text('search_hint')" /></div>
        </div>
      </header>
      <p class="cp-search-status" id="cp-search-status" role="status" aria-live="polite"></p>
      <p class="cp-empty" id="cp-empty" hidden="hidden" tal:content="python:view.page_text('empty')">No settings match.</p>
      <div class="portalMessage warning alert alert-warning"
           role="status"
           tal:condition="view/upgrade_warning">
        <strong i18n:translate="">
          Warning
        </strong>
        <span tal:omit-tag="" i18n:translate="">
          The site configuration is outdated and needs to be
          upgraded. Please
          <a href="#"
             tal:attributes="href string:${context/portal_url}/@@plone-upgrade"
             title="Go to the upgrade page"
             i18n:attributes="title;"
             i18n:name="link_continue_with_the_upgrade"
             i18n:translate="">
            continue with the upgrade
          </a>.
        </span>
      </div>

      <div class="portalMessage warning alert alert-warning"
           role="status"
           tal:condition="view/mailhost_warning">
        <strong i18n:translate="">
          Warning
        </strong>
        <span tal:omit-tag="" i18n:translate="text_no_mailhost_configured">
          You have not configured a mail host or a site 'From'
          address, various features including contact forms, email
          notification and password reset will not work. Go to the
          <tal:link i18n:name="label_mail_control_panel_link">
            <a href=""
               i18n:translate="text_no_mailhost_configured_control_panel_link"
               tal:attributes="href string:${portal_url}/@@mail-controlpanel"
            >Mail control panel</a>
          </tal:link>
          to fix this.
        </span>
      </div>

      <div class="portalMessage warning alert alert-warning"
           role="status"
           tal:condition="view/timezone_warning">
        <strong i18n:translate="">
          Warning
        </strong>
        <span tal:omit-tag="" i18n:translate="text_no_timezone_configured">

          You have not set the portal timezone. Date/Time handling will not
          work properly for timezone aware date/time values.
          Go to the
          <tal:link i18n:name="label_mail_event_settings_link">
            <a href=""
               i18n:translate="text_no_timezone_configured_control_panel_link"
               tal:attributes="href string:${portal_url}/@@dateandtime-controlpanel"
            >Date and Time Settings control panel</a>
          </tal:link>
          to fix this.
        </span>
      </div>

      <div class="portalMessage warning alert alert-warning"
           role="status"
           tal:condition="not:view/pil">
        <strong i18n:translate="">
          Warning
        </strong>
        <span tal:omit-tag="" i18n:translate="text_no_pil_installed">
          PIL is not installed properly, image scaling will not work.
        </span>
      </div>

      <div class="cp-groups">
      <tal:category tal:repeat="category view/categories">
        <tal:defs tal:define="sublist python:view.sublists(category.get('id'))">
          <section class="cp-group" tal:condition="sublist">
            <h2 tal:content="python:view.category_title(category)" i18n:translate="">Category</h2>
            <ul class="cp-grid">
              <tal:actions tal:repeat="action sublist">
                <li tal:condition="action/visible" class="cp-item" tal:attributes="data-search action/title" tal:define="meta python:view.panel_meta(action)">
                  <a class="cp-card" tal:attributes="href action/url">
                    <span class="cp-card-icon" aria-hidden="true"><i tal:attributes="class meta/icon"></i></span>
                    <span class="cp-card-content"><span class="cp-card-title" tal:content="meta/title" i18n:translate="">Title</span>
                      <span class="cp-card-description" tal:content="meta/description">Description</span>
                    </span>
                    <i class="cp-card-arrow fas" tal:attributes="class python:'cp-card-arrow fas fa-chevron-left' if rtl else 'cp-card-arrow fas fa-chevron-right'" aria-hidden="true"></i>
                  </a>
                </li>
              </tal:actions>
            </ul>
          </section>
        </tal:defs>
      </tal:category>
      </div>
      <div class="visualClear"><!-- --></div>

      <details class="cp-technical"><summary tal:content="python:view.page_text('technical')">Technical information</summary><div>
      <h2 i18n:translate="heading_version_overview">Version Overview</h2>
      <ul>
        <tal:list-versions repeat="version view/version_overview">
          <li tal:content="version">Version</li>
        </tal:list-versions>
        <tal:server tal:define="server_info view/server_info;
                                has_wsgi server_info/wsgi;">
          <li>
            <tal:i18n i18n:translate="">WSGI:</tal:i18n>
            <span i18n:translate="" tal:condition="has_wsgi">On</span>
            <span i18n:translate="" tal:condition="not:has_wsgi">Off</span>
          </li>
          <li>
            <tal:i18n i18n:translate="">Server:</tal:i18n>
            <span>${server_info/server_name}</span>
            <span>${server_info/version}</span>
          </li>
        </tal:server>
      </ul>

      <p tal:condition="not:view/is_dev_mode"
         class="discreet text-muted small"
         i18n:translate="description_production_mode">
        You are running in "production mode". This is the preferred mode of
        operation for a live Plone site, but means that some
        configuration changes will not take effect until your server is
        restarted or a product refreshed. If this is a development instance,
        and you want to enable debug mode, stop the server, set 'debug-mode=on'
        in your buildout.cfg, re-run bin/buildout and then restart the server
        process.
      </p>

      <p tal:condition="view/is_dev_mode"
         class="discreet text-muted small"
         i18n:translate="description_debug_mode">
        You are running in "debug mode". This mode is intended for sites that
        are under development. This allows many configuration changes to be
        immediately visible, but will make your site run more slowly. To turn
        off debug mode, stop the server, set 'debug-mode=off' in your
        buildout.cfg, re-run bin/buildout and then restart the server
        process.
      </p>

      </div></details>
      <script>
(function(){
  var root=document.querySelector('.cp-page'),input=root.querySelector('#cp-search');
  var items=[].slice.call(root.querySelectorAll('.cp-item')),groups=[].slice.call(root.querySelectorAll('.cp-group'));
  var empty=root.querySelector('#cp-empty'),status=root.querySelector('#cp-search-status'),fa=root.dir==='rtl';
  function normalize(value){return value.toLocaleLowerCase().replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[\u200c\s]+/g,' ').trim();}
  function filter(){
    var query=normalize(input.value),count=0;
    items.forEach(function(item){item.hidden=query!=='' && normalize(item.textContent+' '+item.getAttribute('data-search')).indexOf(query)===-1;if(!item.hidden)count++;});
    groups.forEach(function(group){group.hidden=![].some.call(group.querySelectorAll('.cp-item'),function(item){return !item.hidden;});});
    empty.hidden=count!==0;
    status.textContent=fa?(count+' بخش'+(query?' مطابق جست‌وجو':' در دسترس')):(count+(query?' matching settings':' available settings'));
  }
  input.addEventListener('input',filter);filter();
}());
      </script>
    </div>

  </body>
</html>
