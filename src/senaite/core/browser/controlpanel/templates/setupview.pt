<html xmlns="http://www.w3.org/1999/xhtml" xmlns:tal="http://xml.zope.org/namespaces/tal" xmlns:metal="http://xml.zope.org/namespaces/metal" xmlns:i18n="http://xml.zope.org/namespaces/i18n" metal:use-macro="here/prefs_main_template/macros/master" i18n:domain="senaite.core">
<body>
 <metal:block fill-slot="top_slot" tal:define="left python:request.set('disable_plone.leftcolumn',1); right python:request.set('disable_plone.rightcolumn',1)"/>
 <metal:block fill-slot="senaite_legacy_js">
  <script tal:attributes="src string:${view/portal/absolute_url}/++plone++senaite.core.static/js/senaite.core.setupview.js?v=20261030-workspace1"></script>
 </metal:block>
 <div metal:fill-slot="prefs_configlet_main" id="lims-controlpanel">
  <style tal:content="structure view/ui_styles"></style>
  <main class="setup-workspace" id="setupview" tal:define="groups view/ui_groups" tal:attributes="dir python:'rtl' if view.is_farsi() else 'ltr'; lang python:'fa' if view.is_farsi() else 'en'; data-section-label python:view.ui_text('section'); data-results-label python:view.ui_text('results')">
   <header class="su-hero">
    <div class="su-identity"><span class="su-mark" aria-hidden="true"><i class="fas fa-sliders-h"></i></span><div><p class="su-eyebrow" tal:content="python:view.ui_text('eyebrow')"></p><h1 tal:content="python:view.ui_text('title')"></h1><p class="su-intro" tal:content="python:view.ui_text('intro')"></p></div></div>
    <div class="su-search"><label for="searchbox" tal:content="python:view.ui_text('search')"></label><div class="su-search-field"><i class="fas fa-search" aria-hidden="true"></i><input id="searchbox" type="search" autocomplete="off" tal:attributes="placeholder python:view.ui_text('placeholder')"/><button type="button" id="setup-clear" hidden="hidden" tal:attributes="aria-label python:view.ui_text('reset')">&#215;</button></div></div>
   </header>
   <nav class="su-groups" tal:attributes="aria-label python:view.ui_text('all')">
    <button type="button" class="su-filter is-active" data-group="all" aria-pressed="true" tal:content="python:view.ui_text('all')"></button>
    <button tal:repeat="group groups" type="button" class="su-filter" aria-pressed="false" tal:attributes="data-group group/id"><span tal:content="group/title"></span><small tal:content="group/count"></small></button>
   </nav>
   <div class="su-help"><p><i class="fas fa-info-circle" aria-hidden="true"></i><span tal:content="python:view.ui_text('hint')"></span></p><span id="setup-result-count" role="status" aria-live="polite" aria-atomic="true"></span></div>
   <section class="su-sections">
    <details tal:repeat="group groups" class="su-group" tal:attributes="data-group-id group/id; open python:'open' if group['id']=='analyses' else None">
     <summary><span class="su-group-icon" aria-hidden="true"><i tal:attributes="class string:fas fa-${group/icon}"></i></span><span class="su-group-heading"><strong tal:content="group/title"></strong><span tal:content="group/description"></span></span><span class="su-group-count"><span tal:content="group/count"></span> <span tal:content="python:view.ui_text('section')"></span></span><span class="su-chevron" aria-hidden="true">&#8964;</span></summary>
     <div class="su-card-grid">
      <a tal:repeat="card group/cards" class="su-card" tal:attributes="href card/url; data-card-id card/id; data-search python:card['title']+' '+card['description']+' '+card['id']">
       <span class="su-card-top"><span class="su-card-icon" aria-hidden="true"><i tal:attributes="class string:fas fa-${card/icon}"></i></span><span class="su-card-arrow" aria-hidden="true">&#8250;</span></span>
       <h2 tal:content="card/title"></h2><p tal:content="card/description"></p>
       <span class="su-card-meta"><span tal:condition="python:card['count'] is not None" tal:content="card/count"></span><span tal:content="card/kind"></span></span>
      </a>
     </div>
    </details>
   </section>
   <div id="setup-empty" class="su-empty" hidden="hidden"><i class="fas fa-search" aria-hidden="true"></i><p tal:content="python:view.ui_text('empty')"></p><button type="button" id="setup-reset" tal:content="python:view.ui_text('reset')"></button></div>
  </main>
 </div>
</body></html>
