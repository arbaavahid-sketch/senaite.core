<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      i18n:domain="plone"
      metal:use-macro="here/main_template/macros/master">
  <body>

    <metal:main fill-slot="main">
      <metal:main-macro define-macro="main">

        <style>
          body:has(.tppc-login-shell) { background: #edf3f1; }
          body:has(.tppc-login-shell) #senaite-toolbar {
            background: #102b2d;
            border-block-end: 3px solid #72c7a9;
          }
          body:has(.tppc-login-shell) #portal-footer-wrapper { display: none; }
          .tppc-login-shell {
            max-inline-size: 76rem;
            margin: clamp(1rem, 4vw, 3.5rem) auto;
            color: #173632;
          }
          .tppc-login-grid {
            display: grid;
            grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
            border-radius: 1.5rem;
            overflow: hidden;
            background: #fff;
            border: 1px solid #d3e3dd;
            box-shadow: 0 18px 55px rgba(15, 53, 47, .12);
          }
          .tppc-login-identity {
            position: relative;
            isolation: isolate;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            min-block-size: 26rem;
            padding: clamp(1.5rem, 4vw, 3rem);
            background: #102b2d;
            color: #fff;
          }
          .tppc-login-photo, .tppc-login-identity::after {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
          }
          .tppc-login-photo { object-fit: cover; object-position: 30% center; z-index: -2; }
          .tppc-login-identity::after {
            content: "";
            background: linear-gradient(0deg, #081f21 4%, rgba(8, 31, 33, .82) 29%, transparent 77%);
            z-index: -1;
          }
          .tppc-login-identity p { margin: 0; color: #d0f3e5; }
          .tppc-login-identity h2 { color: #fff; margin: .6rem 0 0; font-size: clamp(1.35rem, 2.5vw, 2.15rem); }
          #login-form { min-inline-size: 0; padding: clamp(1.15rem, 4vw, 3rem); }
          #login-form .card-body { padding: 0; }
          #login-form h1 { color: #173632; font-weight: 700; }
          #login-form .input-group-text {
            background: #edf5f1;
            color: #245d50;
            border-color: #b8d1c7;
            min-inline-size: 3rem;
            justify-content: center;
          }
          #login-form .input-group input { min-height: 46px; border-color: #b8d1c7; min-width: 0; }
          #login-form .tppc-login-actions input {
            width: 100%;
            min-height: 46px;
            border-radius: .65rem;
            border-color: #205e4d;
            background: #205e4d;
            color: #fff;
          }
          #login-form .tppc-login-actions input:hover { background: #17483b; }
          .tppc-login-shell :focus-visible { outline: 2px solid #1b6b56; outline-offset: 3px; }
          #login-form .card-footer {
            border: 0;
            border-block-start: 1px solid #dce9e3;
            margin-block-start: 1.4rem;
            padding: 1rem 0 0;
            background: transparent;
          }
          .tppc-login-shell a { color: #205e4d; text-underline-offset: .2em; }
          .tppc-login-links { display: flex; flex-wrap: wrap; gap: .5rem; margin: .75rem 0 0; }
          .tppc-login-links a { padding: .45rem .7rem; background: #edf5f1; border-radius: .5rem; }
          .tppc-login-footer {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: .6rem 1.5rem;
            margin-block-start: 1rem;
            padding: .9rem 1.25rem;
            background: #e1eee8;
            border: 1px solid #d3e3dd;
            border-radius: .85rem;
            color: #294b43;
          }
          @media (max-width: 767px) {
            .tppc-login-grid { grid-template-columns: minmax(0, 1fr); }
            .tppc-login-identity { min-block-size: 9rem; }
          }
        </style>
        <div class="tppc-login-shell"
             tal:define="portal_state context/@@plone_portal_state; portal_url portal_state/portal_url">
          <div class="tppc-login-grid">
            <div class="tppc-login-identity" i18n:domain="senaite.core">
              <img alt="" class="tppc-login-photo" tal:attributes="src string:${portal_url}/++plone++senaite.core.static/login-laboratory.png" />
              <p>LIMS</p>
              <h2 i18n:translate="">آزمایشگاه پتروشیمی تندیس پارس</h2>
            </div>
            <div id="login-form">

            <div class="portalMessage error pat-cookietrigger alert alert-danger m-1" style="display:none">
              <strong i18n:translate="">
                Error
              </strong>
              <span tal:omit-tag=""
                    i18n:translate="enable_cookies_message_before_login">
                Cookies are not enabled. You must enable cookies before you can log in.
              </span>
            </div>

            <div class="card-body">

              <tal:card-header tal:condition="python:view.show_lab_name">
                <p class="small text-muted mb-2" tal:content="python:view.lab_name"/>

              </tal:card-header>

              <h1 class="h3 mb-4" i18n:translate="label_log_in">Log in</h1>
              <form action="."
                    method="post"
                    class="loginform"
                    tal:attributes="action view/action; enctype view/enctype">

                <tal:widgets repeat="widget view/widgets/values">

                  <tal:block tal:define="hidden python:widget.mode == 'hidden'">
                    <div class="mb-3" tal:condition="not:hidden">

                      <div class="field form-group"
                           tal:define="error widget/error"
                           tal:attributes="class python:'field' + (error and ' error' or '')">

                        <label for=""
                               tal:attributes="for widget/id"
                               tal:condition="not:hidden">
                          <span i18n:translate=""
                                tal:content="widget/label">label</span>
                          <span class="required horizontal" title="Required"
                                tal:condition="python:widget.required and not hidden"
                                i18n:attributes="title title_required;">&nbsp;</span>
                        </label>

                        <div class="formHelp form-text text-muted"
                             tal:define="description widget/field/description"
                             i18n:translate=""
                             tal:content="description"
                             tal:condition="description">
                          field description
                        </div>

                        <div class="widget input-group flex-nowrap">
                          <div class="input-group-prepend">
                            <div class="input-group-text">
                              <i tal:attributes="class python:view.get_icon_class_for(widget)"></i>
                            </div>
                          </div>
                          <input type="text" tal:replace="structure python:widget.render()" />
                        </div>

                        <div class="form-text small text-danger"
                             tal:condition="error"
                             tal:content="structure error/render">
                          Error
                        </div>

                      </div>

                    </div>

                    <input type="hidden"
                           tal:condition="hidden"
                           tal:replace="structure widget/render" />
                  </tal:block>

                </tal:widgets>
                <span tal:replace="structure context/@@authenticator/authenticator"/>

                <div class="formControls tppc-login-actions">
                  <tal:actions tal:repeat="action view/actions/values|nothing">
                    <input type="submit" tal:replace="structure action/render" />
                  </tal:actions>
                </div>
              </form>
            </div>

            <div class="card-footer small"
                 tal:define="portal_state context/@@plone_portal_state;
                        portal_url portal_state/portal_url">
              <p class="form-text text-muted">
                <span i18n:translate="trouble_logging_in" tal:omit-tag="">Trouble logging in?</span>
                <a href="@@login-help" tal:attributes="href string:${portal_url}/@@login-help" i18n:translate="footer_login_link_get_help">Get help</a>.
              </p>
              <p class="form-text text-muted"
                 tal:condition="python:view.self_registration_enabled()">
                <span i18n:translate="need_an_account" tal:omit-tag="">Need an account?</span>
                <a href="@@register" tal:attributes="href string:${portal_url}/@@register" class="emph" i18n:translate="footer_login_link_signup">Sign up here</a>.
              </p>
              <div class="tppc-login-links" i18n:domain="senaite.core">
                <a tal:attributes="href string:${portal_url}/@@customer-feedback">
                  <i class="fas fa-comment-dots" aria-hidden="true"></i>
                  <span i18n:translate="footer_submit_request">Submit a request</span>
                </a>
                <a tal:attributes="href string:${portal_url}/@@track-request">
                  <i class="fas fa-clipboard-list" aria-hidden="true"></i>
                  <span i18n:translate="footer_track_request">Track a request</span>
                </a>
              </div>
            </div>

          </div>
          </div>
          <footer class="tppc-login-footer small" i18n:domain="senaite.core">
            <span i18n:translate="">آزمایشگاه پتروشیمی تندیس پارس</span>
            <a href="https://tppc.ir/" i18n:translate="">وب‌سایت تندیس پارس</a>
          </footer>
        </div>
      </metal:main-macro>
    </metal:main>
  </body>
</html>
