<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      i18n:domain="plone"
      metal:use-macro="here/main_template/macros/master">
  <body>

    <metal:main fill-slot="main">
      <metal:main-macro define-macro="main">

        <style>
          .tppc-login-photo {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: left center;
            z-index: -1;
          }
          @media (min-width: 768px) {
            #login-form { margin-inline-start: 7% !important; }
          }
          @media (max-width: 767px) {
            .tppc-login-photo { opacity: .55; }
          }
          body:has(#login-form) #senaite-toolbar {
            background-color: #142527;
          }
          body:has(#login-form) #portal-footer-wrapper {
            display: none;
          }
          #login-form .input-group-text {
            background: #edf4f1;
            color: #285d50;
            border-color: #cbdad3;
          }
          #login-form .input-group input {
            min-height: 44px;
            border-color: #cbdad3;
          }
          #login-form .tppc-login-actions input {
            width: 100%;
            min-height: 44px;
            border-radius: .6rem;
            border-color: #205e4d;
            background: #205e4d;
            color: #fff;
          }
          #login-form .tppc-login-actions input:hover {
            background: #194b3e;
          }
          #login-form :focus-visible {
            outline: 2px solid #1b6b56;
            outline-offset: 2px;
          }
          #login-form .card-footer {
            background: #f1f6f3;
          }
          #login-form .card-footer a {
            color: #205e4d;
          }
        </style>
        <div class="w-100 px-3 py-4 position-relative d-flex align-items-center"
             style="min-height: 30rem; isolation: isolate; overflow: hidden; border-radius: 1rem; background: radial-gradient(ellipse at center, #233f3b, #142527 76%);">
          <img alt="" class="tppc-login-photo" tal:attributes="src string:${context/@@plone_portal_state/portal_url}/++plone++senaite.core.static/login-laboratory.png" />
          <div id="login-form" class="card w-100 mx-auto my-3 shadow-sm" style="max-width: 25rem; border: 1px solid #dce7e2; border-radius: 1.25rem; overflow: hidden;">

            <div class="portalMessage error pat-cookietrigger alert alert-danger m-1" style="display:none">
              <strong i18n:translate="">
                Error
              </strong>
              <span tal:omit-tag=""
                    i18n:translate="enable_cookies_message_before_login">
                Cookies are not enabled. You must enable cookies before you can log in.
              </span>
            </div>

            <div class="card-body p-4">

              <tal:card-header tal:condition="python:view.show_lab_name">
                <p class="small text-muted mb-2" tal:content="python:view.lab_name"/>

              </tal:card-header>

              <h1 class="h3 mb-4" i18n:translate="label_log_in">Log in</h1>
              <form action="."
                    method="post"
                    class="loginform"
                    tal:attributes="action view/action; enctype view/enctype">

                <tal:widgets repeat="widget view/widgets/values">

                  <tal:block tal:define="hidden python:widget.mode == 'hidden'">
                    <div class="mb-3" tal:condition="not:hidden">

                      <div class="field form-group"
                           tal:define="error widget/error"
                           tal:attributes="class python:'field' + (error and ' error' or '')">

                        <label for=""
                               tal:attributes="for widget/id"
                               tal:condition="not:hidden">
                          <span i18n:translate=""
                                tal:content="widget/label">label</span>
                          <span class="required horizontal" title="Required"
                                tal:condition="python:widget.required and not hidden"
                                i18n:attributes="title title_required;">&nbsp;</span>
                        </label>

                        <div class="formHelp form-text text-muted"
                             tal:define="description widget/field/description"
                             i18n:translate=""
                             tal:content="description"
                             tal:condition="description">
                          field description
                        </div>

                        <div class="widget input-group flex-nowrap">
                          <div class="input-group-prepend">
                            <div class="input-group-text">
                              <i tal:attributes="class python:view.get_icon_class_for(widget)"></i>
                            </div>
                          </div>
                          <input type="text" tal:replace="structure python:widget.render()" />
                        </div>

                        <div class="form-text small text-danger"
                             tal:condition="error"
                             tal:content="structure error/render">
                          Error
                        </div>

                      </div>

                    </div>

                    <input type="hidden"
                           tal:condition="hidden"
                           tal:replace="structure widget/render" />
                  </tal:block>

                </tal:widgets>
                <span tal:replace="structure context/@@authenticator/authenticator"/>

                <div class="formControls tppc-login-actions">
                  <tal:actions tal:repeat="action view/actions/values|nothing">
                    <input type="submit" tal:replace="structure action/render" />
                  </tal:actions>
                </div>
              </form>
            </div>

            <div class="card-footer small px-4 py-3"
                 tal:define="portal_state context/@@plone_portal_state;
                        portal_url portal_state/portal_url">
              <p class="form-text text-muted">
                <span i18n:translate="trouble_logging_in" tal:omit-tag="">Trouble logging in?</span>
                <a href="@@login-help" tal:attributes="href string:${portal_url}/@@login-help" i18n:translate="footer_login_link_get_help">Get help</a>.
              </p>
              <p class="form-text text-muted"
                 tal:condition="python:view.self_registration_enabled()">
                <span i18n:translate="need_an_account" tal:omit-tag="">Need an account?</span>
                <a href="@@register" tal:attributes="href string:${portal_url}/@@register" class="emph" i18n:translate="footer_login_link_signup">Sign up here</a>.
              </p>
              <hr class="dashed"/>
              <p class="form-text text-muted" i18n:domain="senaite.core">
                <i class="fas fa-comment-dots"></i>
                <a tal:attributes="href string:${portal_url}/@@customer-feedback"
                   i18n:translate="footer_submit_request">Submit a request</a>
                &nbsp;|&nbsp;
                <i class="fas fa-clipboard-list"></i>
                <a tal:attributes="href string:${portal_url}/@@track-request"
                   i18n:translate="footer_track_request">Track a request</a>
              </p>
            </div>

          </div>
        </div>

        <footer class="d-flex flex-wrap justify-content-between align-items-center px-3 py-3 small"
                style="gap: .5rem 1.25rem; border-bottom: 1px solid #dce7e2; color: #445b55;"
                i18n:domain="senaite.core">
          <span i18n:translate="">آزمایشگاه پتروشیمی تندیس پارس</span>
          <a href="https://tppc.ir/" style="color: #205e4d;" i18n:translate="">وب‌سایت تندیس پارس</a>
        </footer>
      </metal:main-macro>
    </metal:main>
  </body>
</html>
