<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="senaite.core">

  <include package="plone.resource"/>

  <!-- One-off admin tool: stamp AnalysisService method/standard strings. -->
  <browser:page
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      name="apply-method-standards"
      class=".tppc_methods.ApplyMethodStandardsView"
      permission="senaite.core.permissions.ManageBika"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- One-off admin tool: bulk-import ISO controlled documents from a folder. -->
  <browser:page
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      name="import-controlled-documents"
      class=".import_documents.ImportControlledDocumentsView"
      permission="senaite.core.permissions.ManageBika"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- One-off admin tool: import Analysis Specification result ranges. -->
  <browser:page
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      name="import-spec-limits"
      class=".import_speclimits.ImportSpecLimitsView"
      permission="senaite.core.permissions.ManageBika"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Static directory for js, css and image resources -->
  <plone:static
      directory="static"
      type="plone"
      name="senaite.core.static"/>

  <!-- Package includes -->
  <include package=".analystperformance"/>
  <include package=".attachment"/>
  <include package=".batches"/>
  <include package=".batching"/>
  <include package=".bootstrap"/>
  <include package=".clients"/>
  <include package=".contentmenu"/>
  <include package=".contentrules"/>
  <include package=".controlpanel"/>
  <include package=".dashboard"/>
  <include package=".documentstatus"/>
  <include package=".installdocuments"/>
  <include package=".customercare"/>
  <include package=".customerfeedback"/>
  <include package=".installcustomercare"/>
  <include package=".samplerequest"/>
  <include package=".installsampleintake"/>
  <include package=".dexterity"/>
  <include package=".fields"/>
  <include package=".form"/>
  <include package=".frontpage"/>
  <include package=".globals"/>
  <include package=".idserver"/>
  <include package=".install"/>
  <include package=".instrumentstatus"/>
  <include package=".label"/>
  <include package=".listing"/>
  <include package=".login"/>
  <include package=".main_template"/>
  <include package=".modals"/>
  <include package=".portlets"/>
  <include package=".quickinstaller"/>
  <include package=".samples"/>
  <include package=".setup"/>
  <include package=".sharing"/>
  <include package=".stickers"/>
  <include package=".user"/>
  <include package=".usergroup"/>
  <include package=".viewlets"/>
  <include package=".widgets"/>
  <include package=".workflow"/>
  <include package=".worksheets"/>

</configure>
