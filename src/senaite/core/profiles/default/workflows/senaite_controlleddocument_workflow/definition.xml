<?xml version="1.0"?>
<dc-workflow xmlns:i18n="http://xml.zope.org/namespaces/i18n"
             workflow_id="senaite_controlleddocument_workflow"
             title="Senaite controlled document Workflow"
             description=""
             state_variable="review_state"
             initial_state="draft"
             manager_bypass="False"
             i18n:domain="senaite.core">

  <!--
  Controlled document lifecycle for ISO/IEC 17025 clause 8.3:

    draft  [approve] to effective
    effective  [retire] to obsolete
    effective  [revise] to draft
    obsolete   [revise] to draft

  Approving/retiring requires "Review portal content" (reviewer/manager), so an
  author who only has "Modify portal content" cannot approve their own document
  (segregation of duties). Revising (creating a new working copy) requires
  "Modify portal content".
  -->

  <!-- PERMISSIONS -->
  <permission>Access contents information</permission>
  <permission>Delete objects</permission>
  <permission>List folder contents</permission>
  <permission>Modify portal content</permission>
  <permission>Review portal content</permission>
  <permission>View</permission>

  <!-- State: draft -->
  <state state_id="draft" title="Draft" i18n:attributes="title">
    <exit-transition transition_id="approve" />

    <permission-map name="Access contents information" acquired="True" />
    <permission-map name="Delete objects" acquired="True" />
    <permission-map name="List folder contents" acquired="True" />
    <permission-map name="Modify portal content" acquired="True" />
    <permission-map name="Review portal content" acquired="True" />
    <permission-map name="View" acquired="True" />
  </state>

  <!-- State: effective (approved / in force) -->
  <state state_id="effective" title="Effective" i18n:attributes="title">
    <exit-transition transition_id="retire" />
    <exit-transition transition_id="revise" />

    <permission-map name="Access contents information" acquired="True" />
    <permission-map name="Delete objects" acquired="False" />
    <!-- An effective controlled document must not be edited in place -->
    <permission-map name="Modify portal content" acquired="False" />
    <permission-map name="List folder contents" acquired="True" />
    <permission-map name="Review portal content" acquired="True" />
    <permission-map name="View" acquired="True" />
  </state>

  <!-- State: obsolete (retired / superseded) -->
  <state state_id="obsolete" title="Obsolete" i18n:attributes="title">
    <exit-transition transition_id="revise" />

    <permission-map name="Access contents information" acquired="True" />
    <permission-map name="Delete objects" acquired="False" />
    <permission-map name="Modify portal content" acquired="False" />
    <permission-map name="List folder contents" acquired="True" />
    <permission-map name="Review portal content" acquired="True" />
    <permission-map name="View" acquired="True" />
  </state>

  <!-- Transition: approve -->
  <transition transition_id="approve" title="Approve" new_state="effective"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Approve</action>
    <guard>
      <guard-permission>Review portal content</guard-permission>
    </guard>
  </transition>

  <!-- Transition: retire -->
  <transition transition_id="retire" title="Retire" new_state="obsolete"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Retire</action>
    <guard>
      <guard-permission>Review portal content</guard-permission>
    </guard>
  </transition>

  <!-- Transition: revise (back to draft for a new version).
       Guarded by "Review portal content" so it is also reachable from the
       obsolete state, where "Modify portal content" is intentionally removed. -->
  <transition transition_id="revise" title="Revise" new_state="draft"
              trigger="USER" before_script="" after_script=""
              i18n:attributes="title">
    <action url="" category="workflow" icon="">Revise</action>
    <guard>
      <guard-permission>Review portal content</guard-permission>
    </guard>
  </transition>

  <variable variable_id="action" for_catalog="False" for_status="True" update_always="True">
    <description>Previous transition</description>
    <default>
      <expression>transition/getId|nothing</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="actor" for_catalog="False" for_status="True" update_always="True">
    <description>The ID of the user who performed the last transition</description>
    <default>
      <expression>user/getId</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="comments" for_catalog="False" for_status="True" update_always="True">
    <description>Comment about the last transition</description>
    <default>
      <expression>python:state_change.kwargs.get('comment', '')</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="review_history" for_catalog="False" for_status="False" update_always="False">
    <description>Provides access to workflow history</description>
    <default>
      <expression>state_change/getHistory</expression>
    </default>
    <guard>
    </guard>
  </variable>

  <variable variable_id="time" for_catalog="False" for_status="True" update_always="True">
    <description>When the previous transition was performed</description>
    <default>
      <expression>state_change/getDateTime</expression>
    </default>
    <guard>
    </guard>
  </variable>

</dc-workflow>
